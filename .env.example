# Supabase (wajib untuk menjalankan app)
# Buat project di https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: Project Settings → API → `service_role` (RAHASIA, server-only)
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (dipakai mulai Milestone 3: RAG pipeline & chat) ---
# Satu API key OpenRouter untuk chat + embedding (OpenAI-compatible).
# Daftar & buat key di https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=openrouter/auto
EMBEDDING_MODEL=openai/text-embedding-3-small
